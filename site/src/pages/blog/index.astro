---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../../layouts/Base.astro";

interface BlogPost {
  title: string;
  description: string;
  date: Date;
  categories: string[];
  href: string;
  format: string;
  image?: ImageMetadata;
}

const nativePosts: BlogPost[] = (await getCollection("writing", ({ data }) => !data.draft)).map((post) => ({
  title: post.data.title,
  description: post.data.description,
  date: post.data.date,
  categories: post.data.categories,
  href: `/blog/${post.id.replace(/\/index$/, "")}/`,
  format: post.data.format,
  image: post.data.image,
}));

const posts = nativePosts.sort((a, b) => b.date.valueOf() - a.date.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.categories))].sort((a, b) => a.localeCompare(b));
const formatDate = (date: Date) => new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(date);
const tagKey = (tag: string) => tag.toLocaleLowerCase();
---

<Base title="Blog — Suchit G" description="Technical essays, experiments, and working notes by Suchit G.">
  <header class="page-intro shell">
    <p class="kicker"><span></span> Blog</p>
    <h1>I build <em>systems</em><br />and write<br />to understand them.</h1>
    <p>Deep dives, experiment logs, and practical explanations from the things I’m learning by building.</p>
  </header>

  <section class="archive shell" aria-label="Blog archive">
    <div class="archive-tools">
      <div class="tag-filters" role="group" aria-label="Filter blog posts by tag">
        <button type="button" class="is-active" data-tag="all" aria-pressed="true">All</button>
        {tags.map((tag) => <button type="button" data-tag={tagKey(tag)} aria-pressed="false">{tag}</button>)}
      </div>
      <label class="sort-control">
        <span>Sort</span>
        <select id="blog-sort" aria-label="Sort blog posts">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </label>
    </div>

    <div class="archive-head">
      <span><span data-result-count>{posts.length}</span> entries</span>
      <span data-sort-label>Newest first</span>
    </div>

    <div class="archive-list">
      {posts.map((post, index) => (
        <article
          class:list={["archive-item", { "has-thumbnail": post.image }]}
          data-date={post.date.toISOString()}
          data-tags={post.categories.map(tagKey).join("|")}
        >
          <a class="archive-row" href={post.href}>
            <span class="archive-num">{(index + 1).toString().padStart(2, "0")}</span>
            {post.image && (
              <Image
                class="archive-thumbnail"
                src={post.image}
                alt=""
                widths={[220, 320]}
                sizes="(max-width: 760px) 84px, 126px"
                loading="lazy"
              />
            )}
            <div class="archive-copy">
              <p>{post.categories.slice(0, 2).join(" · ") || "Notes"}</p>
              <h2>{post.title}</h2>
              <span>{post.description}</span>
            </div>
            <span class="archive-meta">{formatDate(post.date)}<br />{post.format}</span>
            <span class="archive-arrow">↗</span>
          </a>
        </article>
      ))}
    </div>
    <p class="archive-empty" hidden>No blog posts match this tag.</p>
  </section>

  <script is:inline>
    (() => {
      const list = document.querySelector(".archive-list");
      const items = [...document.querySelectorAll(".archive-item")];
      const buttons = [...document.querySelectorAll(".tag-filters button")];
      const select = document.querySelector("#blog-sort");
      const count = document.querySelector("[data-result-count]");
      const sortLabel = document.querySelector("[data-sort-label]");
      const empty = document.querySelector(".archive-empty");
      if (!(list instanceof HTMLElement) || !(select instanceof HTMLSelectElement)) return;

      let activeTag = "all";

      const render = () => {
        const direction = select.value === "oldest" ? 1 : -1;
        items
          .sort((a, b) => direction * (Date.parse(a.dataset.date || "") - Date.parse(b.dataset.date || "")))
          .forEach((item) => list.append(item));

        let visible = 0;
        items.forEach((item) => {
          const tags = (item.dataset.tags || "").split("|");
          const show = activeTag === "all" || tags.includes(activeTag);
          item.hidden = !show;
          if (show) visible += 1;
        });

        items.filter((item) => !item.hidden).forEach((item, index) => {
          const number = item.querySelector(".archive-num");
          if (number) number.textContent = String(index + 1).padStart(2, "0");
        });
        if (count) count.textContent = String(visible);
        if (sortLabel) sortLabel.textContent = select.value === "oldest" ? "Oldest first" : "Newest first";
        if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      };

      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          activeTag = button.dataset.tag || "all";
          buttons.forEach((candidate) => {
            const selected = candidate === button;
            candidate.classList.toggle("is-active", selected);
            candidate.setAttribute("aria-pressed", String(selected));
          });
          render();
        });
      });
      select.addEventListener("change", render);
    })();
  </script>
</Base>
